<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.MachineLearning.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Only Rhino ships a .NET 7 runtime; roll forward so `dotnet test` works
         against whatever is installed. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- No RhinoCommon and no Rhino.Inside. The clustering pipeline is pure
         numerics, so unlike the StructuralForm tests these run anywhere -
         including a hosted CI runner with no Rhino and no licence. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <ProjectReference Include="..\..\src\OtterLogic.MachineLearning\OtterLogic.MachineLearning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by python/fixtures/make_fixtures.py and committed. -->
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
