<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OtterLogic.MachineLearning</RootNamespace>
    <AssemblyName>OtterLogic.MachineLearning</AssemblyName>
    <!-- A layer, not a domain: it sits above Core and below the toolkits, and a
         toolkit may reference it. No UI, no Grasshopper, and no dependency on
         any toolkit. See docs/architecture.md. -->

    <IsPackable>true</IsPackable>
    <PackageId>OtterLogic.MachineLearning</PackageId>
    <Description>The shared base under the OtterLogic machine learning repos - feature preprocessing, decomposition, distances and the training job protocol; the dataset contract is the sibling Dataset package. ONNX inference is the sibling Inference project.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Otter-Logic/MachineLearning</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Otter-Logic/MachineLearning</RepositoryUrl>
    <PackageTags>rhino;rhino3d;grasshopper;computational-design;machine-learning</PackageTags>

  </PropertyGroup>

  <ItemGroup>
    <!-- The tests reach TrainerRuntime.InstallRootOverride and nothing else; it
         exists so an install test can unpack into a temporary folder instead of
         the %LOCALAPPDATA% folder a user's real runtime lives in. -->
    <InternalsVisibleTo Include="OtterLogic.MachineLearning.Tests" />
  </ItemGroup>

  <!-- Deliberately no package references. A Jacobi eigensolve for small
       matrices and a filtered subspace iteration for large sparse ones are a few
       hundred lines between them; MathNet would be carried for arithmetic that
       is already here. The one dependency the stack does need,
       Microsoft.ML.OnnxRuntime, lives in the sibling Inference project so that
       its native binaries never reach a consumer that only wants this. -->

  <!-- A sibling checkout of Core wins; the published package is the fallback. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Core\src\OtterLogic.Core\OtterLogic.Core.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Core" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Dataset holds the dataset contract - schema, sample table, folder on disk,
       split by group - and the delimited text under it. It sat in this project
       as Data/ until 2026-09, when a repo one layer down existed to hold it; it
       moved for the same reason anything two paradigms need moves down. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Dataset\src\OtterLogic.Dataset\OtterLogic.Dataset.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Dataset\src\OtterLogic.Dataset\OtterLogic.Dataset.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Dataset" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Graphs holds the graph contract and sits beside Core, below this layer.
       Referenced here rather than by each consumer so that everything above gets
       WeightedGraph the way it always did - through this project - and only one
       csproj knows where it lives. -->
  <Choose>
    <When Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Graphs\src\OtterLogic.Graphs\OtterLogic.Graphs.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\Graphs\src\OtterLogic.Graphs\OtterLogic.Graphs.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="OtterLogic.Graphs" Version="[$(Version)]" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
